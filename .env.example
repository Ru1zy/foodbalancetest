# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Application session signing
AUTH_SECRET="replace-with-a-long-random-secret"

# Telegram
TELEGRAM_BOT_TOKEN="replace-with-bot-token"
TELEGRAM_ADMIN_CHAT_ID="replace-with-admin-chat-id"
TELEGRAM_WEBHOOK_SECRET="replace-with-random-webhook-secret"
NEXT_PUBLIC_BOT_USERNAME="replace-with-bot-username-without-at-sign"

# Google OAuth
GOOGLE_CLIENT_ID="replace-with-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://example.com/api/auth/google/callback"

# Google Sheets service account (primary credential format)
GOOGLE_CLIENT_EMAIL="replace-with-service-account-email"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheets destinations
GOOGLE_SHEET_ID="replace-with-global-crm-spreadsheet-id"
EXTERNAL_SHEET_ID="replace-with-kitchen-spreadsheet-id"

# Legacy kitchen-export credential format. This remains required by
# app/api/admin/export-kitchen until the Google credential paths are unified.
GOOGLE_SERVICE_ACCOUNT_KEY="replace-with-complete-service-account-json"

# Optional legacy Google Apps Script endpoint
GAS_WEBAPP_URL=""

# S3-compatible object storage
S3_ENDPOINT="https://example.supabase.co/storage/v1/s3"
S3_REGION="auto"
S3_BUCKET="replace-with-public-image-bucket"
S3_ACCESS_KEY_ID="replace-with-s3-access-key"
S3_SECRET_ACCESS_KEY="replace-with-s3-secret-key"
S3_PUBLIC_BASE_URL="https://example.supabase.co/storage/v1/object/public/BUCKET"
S3_FORCE_PATH_STYLE="true"

# Cron endpoint authentication. The same value must also be stored as the
# GitHub Actions repository secret CRON_SECRET.
CRON_SECRET="replace-with-a-long-random-secret"
